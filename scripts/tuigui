#!/usr/bin/env bash
set -euo pipefail

SERVICE=titanus-installer-web.service
STATE_DIR=/var/lib/titanus/installer-web
TOKEN_FILE="$STATE_DIR/access.token"
PORT=8088

if [[ ${EUID} -ne 0 ]]; then
  echo "tuigui must run as root." >&2
  exit 1
fi
if ! command -v titanus-installer-web >/dev/null 2>&1; then
  echo "titanus-installer-web is not installed. Install a Titanus Core release that includes Web Installer support." >&2
  exit 1
fi
if ! command -v titanus >/dev/null 2>&1; then
  echo "Titanus Core CLI is not installed." >&2
  exit 1
fi
echo "Preparing installer dependencies and verified release archives..."
titanus installer prepare

if ! command -v systemctl >/dev/null 2>&1; then
  echo "systemd is required to start the Titanus Core Web Installer." >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required by the Titanus installer launch commands." >&2
  exit 1
fi
if ! python3 - "$(titanus version --json)" "$(titanus-installer-web --version-json)" <<'PY'
import json,sys
core=json.loads(sys.argv[1]); web=json.loads(sys.argv[2])
keys=('version','revision','state_profile')
raise SystemExit(0 if all(core.get(k)==web.get(k) for k in keys) else 1)
PY
then
  echo "The installed Web Installer does not match the active Titanus Core release. Use 'tuicli' or install a matching release before starting tuigui." >&2
  exit 1
fi

# An idle older service must be quiesced before replacing its TLS identity.
# Current services keep their durable running session and dynamically reload TLS.
PID=$(systemctl show "$SERVICE" --property=MainPID --value 2>/dev/null || true)
if [[ "$PID" =~ ^[1-9][0-9]*$ ]]; then
  if ! SERVICE_MODE=$(python3 - <<'PYWEBMODE'
import json,os,ssl,subprocess,sys,urllib.request
try:
    ca=os.environ.get('TITANUS_INSTALLER_TLS_CA')
    settings='/etc/titanus/installer-tls.json'
    if not ca and os.path.isfile(settings): ca=json.load(open(settings))['ca']
    if not ca: ca='/var/lib/titanus/installer-web/https-ca.crt'
    if not os.path.isfile(ca): ca='/var/lib/titanus/installer-web/https.crt'
    context=ssl.create_default_context(cafile=ca)
    token=open('/var/lib/titanus/installer-web/access.token').read().strip()
    headers={'Content-Type':'application/json','X-Titanus-Installer-Token':token}
    def request(endpoint,data=None):
        req=urllib.request.Request('https://127.0.0.1:8088/api/v1/'+endpoint,headers=headers,data=data)
        with urllib.request.urlopen(req,context=context,timeout=35) as response: return json.load(response)
    current=request('bootstrap');target=json.loads(subprocess.check_output(['titanus','version','--json']))
    if all(current.get(k)==target.get(k) for k in ('version','revision')): print('current')
    else:
        if not request('quiesce',b'{}').get('quiesced'): raise RuntimeError('not idle')
        print('restart')
except Exception:
    print('Cannot verify an idle Web Installer for upgrade. No service was stopped and no TLS identity was changed.',file=sys.stderr)
    sys.exit(1)
PYWEBMODE
  ); then exit 1; fi
  if [[ "$SERVICE_MODE" == restart ]]; then systemctl stop "$SERVICE"; fi
fi

TLS_INFO=$(titanus-installer-web --prepare-tls --install-local-trust)
TLS_CA=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["ca_file"])' "$TLS_INFO")
TLS_FINGERPRINT=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1])["ca_sha256"])' "$TLS_INFO")

systemctl daemon-reload
systemctl start "$SERVICE"

for _ in $(seq 1 50); do
  if systemctl is-active --quiet "$SERVICE" && [[ -s "$TOKEN_FILE" ]]; then
    break
  fi
  sleep 0.2
done
if ! systemctl is-active --quiet "$SERVICE"; then
  echo "Titanus Core Web Installer failed to start." >&2
  systemctl --no-pager --full status "$SERVICE" >&2 || true
  exit 1
fi
if [[ ! -s "$TOKEN_FILE" ]]; then
  echo "Titanus Core Web Installer started but the protected access token is not available." >&2
  exit 1
fi

IP=$(python3 - <<'PYIP'
import ipaddress,json,subprocess

def ip_json(*args):
    try:
        result=subprocess.run(['ip','-j','-4',*args],capture_output=True,text=True,timeout=5)
        return json.loads(result.stdout) if result.returncode==0 else []
    except (OSError,ValueError,subprocess.TimeoutExpired):
        return []

def usable(value):
    try:
        address=ipaddress.IPv4Address(value)
        return not (address.is_loopback or address.is_unspecified or address.is_multicast or address.is_link_local)
    except ValueError:
        return False

candidates=[route.get('prefsrc','') for route in ip_json('route','get','1.1.1.1')]
candidates += [a.get('local','') for interface in ip_json('address','show','up')
               for a in interface.get('addr_info',[]) if a.get('scope')=='global']
print(next((value for value in candidates if usable(value)),''))
PYIP
)
if [[ -z "$IP" ]]; then
  echo "Titanus Core Web Installer is running, but no non-loopback IPv4 address could be detected." >&2
  echo "Run 'ip -4 addr' and open https://<this-host-ip>:$PORT/ in your browser." >&2
  exit 1
fi

TOKEN=$(tr -d '\r\n' < "$TOKEN_FILE")
if [[ ! "$TOKEN" =~ ^[0-9a-f]{64}$ ]]; then
  echo "Titanus Core Web Installer access token is invalid." >&2
  exit 1
fi

cat <<OUT
Titanus Core Web Installer is running.
Detected local IPv4 address: $IP
Open this protected URL in your browser:

  https://$IP:$PORT/#access=$TOKEN

TLS covers this host's detected addresses, hostname, localhost and loopback addresses.
This issuer is enrolled in the installer host trust store.
Issuer CA certificate: $TLS_CA
Issuer CA SHA256 fingerprint: $TLS_FINGERPRINT
Before the first browser connection, enroll the issuer CA in the client's trusted roots
using a trusted channel such as SSH or your organization's certificate policy.
Verify the fingerprint above. An already trusted corporate CA needs no extra enrollment.
The CA stays the same when this host changes IP or subnet; server certificates renew automatically.
After the first successful sign-in, reopening https://$IP:$PORT/ in the same browser will restore the current installation status.
The installer service continues running if you close or refresh the browser.
Use 'tuicli' at any time when you want the terminal-only installer.
OUT
